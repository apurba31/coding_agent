# Copy to .env and configure one provider before running `mini-agent chat`.
MINI_AGENT_LLM_PROVIDER=groq
# Optional; Groq defaults to llama3-70b-8192. For NVIDIA, use a model available in NVIDIA NIM.
# MINI_AGENT_LLM_MODEL=
GROQ_API_KEY=your-groq-api-key

# To use NVIDIA NIM instead, set MINI_AGENT_LLM_PROVIDER=nvidia and configure:
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=your-nvidia-model-id
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional retrieval tuning (defaults shown)
# MINI_AGENT_USE_RERANKER=true
# MINI_AGENT_RERANK_ALPHA=0.7

# Optional local MCP stdio servers (install with `pip install -e '.[mcp]'`).
# MINI_AGENT_MCP_SERVERS='{"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/path/to/repo"]}}'
